# Copie a .env y defina valores propios (nunca versionar .env)
MSSQL_SA_PASSWORD=
SQLSERVER_HOST_PORT=14333
DB_NAME=CargaMasivaApp
# RabbitMQ (Feature 005): credenciales del broker; obligatorias
RABBITMQ_USER=
RABBITMQ_PASSWORD=
# JWT compartido por Autenticacion, Gateway y Control (Feature 005): clave HS256 de al menos 32 bytes; obligatoria
JWT_CLAVE=
JWT_EMISOR=ms-autenticacion
JWT_AUDIENCIA=carga-masiva
# SMTP de ms-notificaciones (Feature 007): servidor de correo por variables de entorno; sin valores secretos.
# Obligatorias: SMTP_HOST y SMTP_REMITENTE (sin ellas Compose no arranca). Opcionales: SMTP_USUARIO y SMTP_CLAVE
# (si hay usuario, la clave es obligatoria). SMTP_SEGURIDAD: None, StartTls, SslOnConnect o Auto.
# Los valores siguientes son EJEMPLOS ilustrativos, no un servidor real: sustitúyalos por los de su servidor SMTP.
#   SMTP_HOST=smtp.ejemplo.com
#   SMTP_PUERTO=587
#   SMTP_SEGURIDAD=StartTls
#   SMTP_USUARIO=usuario@ejemplo.com
#   SMTP_REMITENTE=notificaciones@ejemplo.com
# EJEMPLO LOCAL con Mailpit (servicio de Compose; captura los correos en http://localhost:8025 sin entregarlos
# a buzones externos). Sin TLS ni autenticación SOLO para pruebas locales:
#   SMTP_HOST=mailpit
#   SMTP_PUERTO=1025
#   SMTP_SEGURIDAD=None
#   SMTP_REMITENTE=notificaciones@carga-masiva.test
SMTP_HOST=
SMTP_PUERTO=587
SMTP_SEGURIDAD=StartTls
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_REMITENTE=
