# Copie a .env y defina valores propios (nunca versionar .env)
MSSQL_SA_PASSWORD=
SQLSERVER_HOST_PORT=14333
DB_NAME=CargaMasivaApp
# RabbitMQ (Feature 005): credenciales del broker; obligatorias
RABBITMQ_USER=
RABBITMQ_PASSWORD=
# JWT compartido por Autenticacion, Gateway y Control (Feature 005): clave HS256 de al menos 32 bytes; obligatoria
JWT_CLAVE=
JWT_EMISOR=ms-autenticacion
JWT_AUDIENCIA=carga-masiva
